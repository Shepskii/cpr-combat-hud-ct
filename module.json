{
  "id": "cpr-combat-hud-ct",
  "title": "Cyberpunk RED - Combat HUD (Combat Tools edition)",
  "description": "A fork of Vec97's Cyberpunk RED - Combat HUD for tables that fight through Pneuma's Combat Tools: the GM chooses who can start attacks from the HUD (by default only the GM). HP, armor, stats, skills, role abilities, netrunning, reloading and equipping stay for everyone.",
  "version": "1.0.0",
  "authors": [
    {
      "name": "Vec97",
      "url": "https://github.com/Vec97"
    },
    {
      "name": "Shepskii"
    }
  ],
  "compatibility": {
    "minimum": "12",
    "verified": "12"
  },
  "relationships": {
    "systems": [
      {
        "id": "cyberpunk-red-core",
        "type": "system",
        "compatibility": {}
      }
    ],
    "conflicts": [
      {
        "id": "cpr-combat-hud",
        "type": "module",
        "reason": "Both draw the same HUD bar; enable only one of them."
      },
      {
        "id": "cpr-hud-combat-tools-bridge",
        "type": "module",
        "reason": "Not needed with this fork, and it only works with the original HUD."
      }
    ]
  },
  "esmodules": [
    "scripts/main.js"
  ],
  "styles": [
    "styles/combat-hud.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "languages/en.json"
    }
  ],
  "url": "https://github.com/Shepskii/cpr-combat-hud-ct",
  "manifest": "https://github.com/Shepskii/cpr-combat-hud-ct/releases/latest/download/module.json",
  "download": "https://github.com/Shepskii/cpr-combat-hud-ct/releases/latest/download/module.zip",
  "readme": "https://github.com/Shepskii/cpr-combat-hud-ct/blob/main/README.md",
  "changelog": "https://github.com/Shepskii/cpr-combat-hud-ct/blob/main/CHANGELOG.md",
  "bugs": "https://github.com/Shepskii/cpr-combat-hud-ct/issues",
  "license": "MIT"
}
